// NARTHECare iOS — Cognito Hosted UI configuration template
//
// This file defines the build settings that are injected into Info.plist
// at compile time via $(VAR_NAME) expansions.
//
// HOW TO USE
// ----------
// 1. Copy this file:
//      cp apps/ios/Config.xcconfig apps/ios/Config.local.xcconfig
// 2. Fill in the real values in Config.local.xcconfig.
// 3. In Xcode: Project → Info → Configurations → expand Debug and Release
//    → set the configuration file for the NARTHECareApp target to
//    "Config.local" (Xcode strips the .xcconfig extension in the picker).
// 4. Config.local.xcconfig is gitignored — never commit real credentials.
//
// COGNITO_REDIRECT_URI must exactly match the value registered in the
// Cognito App Client's "Allowed callback URLs" in the AWS console.

COGNITO_USER_POOL_ID = 
COGNITO_CLIENT_ID = 
COGNITO_REGION = us-east-1
// Cognito Hosted UI domain, e.g. narthecare.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN = 
// NOTE: xcconfig treats "//" as a comment. We interpose an empty
// variable expansion "$()" between the two slashes so the value is
// stored intact ("narthecare://auth/callback") without triggering the
// comment lexer. Do not collapse this back to "//".
COGNITO_REDIRECT_URI = narthecare:/$()/auth/callback

// Backend API base URL (no trailing slash). The production Aptible URL
// is the safe default committed here so a developer who has not created
// a Config.local.xcconfig still gets real-backend behavior. Override
// per developer in Config.local.xcconfig for local backend testing
// (e.g. API_BASE_URL = http:/$()/localhost:3000 — the "$()" trick is
// required to keep the "//" intact through the xcconfig parser).
API_BASE_URL = https:/$()/app-107635.on-aptible.com
