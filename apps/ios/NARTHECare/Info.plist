<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NARTHECare</string>
	<!-- Cognito Hosted UI redirect URI: narthecare://auth/callback
	     Values expand from build settings set in Config.xcconfig.
	     See apps/ios/Config.xcconfig for setup instructions. -->
	<key>NARTHECareCognitoUserPoolId</key>
	<string>$(COGNITO_USER_POOL_ID)</string>
	<key>NARTHECareCognitoClientId</key>
	<string>$(COGNITO_CLIENT_ID)</string>
	<key>NARTHECareCognitoRegion</key>
	<string>$(COGNITO_REGION)</string>
	<key>NARTHECareCognitoDomain</key>
	<string>$(COGNITO_DOMAIN)</string>
	<key>NARTHECareCognitoRedirectUri</key>
	<string>$(COGNITO_REDIRECT_URI)</string>
	<!-- Backend API base URL (no trailing slash). Defaults to the
	     production Aptible endpoint via Config.xcconfig; override per
	     developer in Config.local.xcconfig (e.g. http://localhost:3000)
	     for local backend testing. APIClient.defaultBaseURL reads this. -->
	<key>NARTHECareAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Custom URL scheme so iOS routes narthecare://auth/callback to this app.
	     This is the Cognito Hosted UI redirect URI for local iOS login. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.narthecare.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>narthecare</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Narrow ATS exception so local-only http://localhost:3000 can be
	     reached for backend dev testing on the iOS Simulator. Real
	     backends still go over HTTPS — this exception only covers the
	     `localhost` host and explicitly does NOT relax ATS for any
	     other domain (no NSAllowsArbitraryLoads). Production builds
	     should never set API_BASE_URL to a localhost value, so the
	     exception is effectively unused outside of local dev. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>This app reads steps, heart rate, and sleep to send them to your NARTHECare backend.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app does not write health data to HealthKit.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
